# ------------------------------
# Database (MySQL)
# ------------------------------
DATABASE_URL="mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>"
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=atttrack

# ------------------------------
# Redis
# ------------------------------
REDIS_URL="redis://<REDIS_USER>:<REDIS_PASSWORD>@<REDIS_HOST>:<REDIS_PORT>"
REDIS_USER=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_NAME=0

# Cache time-to-live (in seconds/minutes/hours - specify unit used in code)
TTL_CACHE=1

# ------------------------------
# Server
# ------------------------------
PORT=8000
NODE_ENV="development"

# ------------------------------
# Google Sheets
# ------------------------------
GSHEET_ID="your_google_sheet_id"

# ------------------------------
# Auth
# ------------------------------
JWT_SECRET="your_jwt_secret"
